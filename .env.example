# Copy this file to .env and fill in your AACT account details.
# Never commit .env to GitHub.
AACT_USER=your_aact_username
AACT_PASSWORD=your_aact_password
AACT_HOST=aact-db.ctti-clinicaltrials.org
AACT_PORT=5432
AACT_DB=aact

# LLM for scripts/stop_reason_llm.py (any OpenAI-compatible API). Free options:
#   Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
#   Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
#   Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=llama-3.3-70b-versatile
# LLM_BATCH_SIZE=20
# LLM_MIN_INTERVAL=3
